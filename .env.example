# Copy to .env and fill in.
# SQLite file for development. For production use a PostgreSQL URL.
DATABASE_URL="file:./dev.db"

# At least 32 random characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Secret for scheduled jobs (e.g. POST /api/jobs/close-sessions). 16+ characters.
CRON_SECRET=""

# "console" prints emails/SMS to the server log and .outbox/ (development).
MAIL_TRANSPORT="console"

# Public address of the app, used in email links (unsubscribe, notices).
APP_URL="http://localhost:3000"

# Real email (MAIL_TRANSPORT="smtp"). Use a domain with SPF and DKIM set up.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# MAIL_FROM="College Attendance <attendance@your-college.edu>"
